{
  "name": "lens-a11y",
  "version": "0.1.0",
  "description": "Zero-dependency visual & motor impairment simulator and accessibility auditor.",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "unpkg": "./dist/lens.min.js",
  "jsdelivr": "./dist/lens.min.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./lens.min.js": "./dist/lens.min.js"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup && node -e \"const fs=require('fs');fs.mkdirSync('../../apps/web/public',{recursive:true});fs.copyFileSync('dist/lens.min.js','../../apps/web/public/lens.min.js');fs.mkdirSync('../extension',{recursive:true});fs.copyFileSync('dist/lens.min.js','../extension/lens.min.js');\"",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}