{
  "name": "lens-a11y",
  "version": "0.1.0",
  "description": "Zero-dependency optical accessibility simulator (color blindness, cataracts, glaucoma, dyslexia, motor tremor) and live WCAG 2.1 DOM auditor.",
  "license": "MIT",
  "author": "Gaurav Joshi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Itsgauravvv/Aperture.git",
    "directory": "packages/lens"
  },
  "homepage": "https://github.com/Itsgauravvv/Aperture#readme",
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "color-blindness",
    "simulation",
    "auditor",
    "hud"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./dist/lens.min.js": "./dist/lens.min.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup && node -e \"const fs=require('fs');fs.mkdirSync('../../apps/web/public',{recursive:true});fs.copyFileSync('dist/lens.min.js','../../apps/web/public/lens.min.js');fs.mkdirSync('../extension',{recursive:true});fs.copyFileSync('dist/lens.min.js','../extension/lens.min.js');\"",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "jsdom": "^25.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}